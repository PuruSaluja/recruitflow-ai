# Copy to .env and adjust for your environment.

# --- Database -----------------------------------------------------------
# Full SQLAlchemy URL for the application database.
RECRUITFLOW_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recruitflow

# Database used by the pytest suite. Create it once; the suite migrates it
# itself and empties every table between tests, so point it somewhere
# disposable. The name must end in _test and differ from the URL above, or the
# run refuses to start.
RECRUITFLOW_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recruitflow_test

# Seconds to wait for a TCP connection before giving up. It bounds one attempt
# rather than the whole request; see the note in app/config.py.
RECRUITFLOW_DB_CONNECT_TIMEOUT=3
# Seconds to wait for a free connection when the pool is saturated.
RECRUITFLOW_DB_POOL_TIMEOUT=10

# --- API ----------------------------------------------------------------
RECRUITFLOW_API_PREFIX=/api/v1
RECRUITFLOW_CORS_ORIGINS=http://localhost:5173

# --- Logging ------------------------------------------------------------
# Lowest level of the app's own log lines written to stderr: DEBUG, INFO,
# WARNING, ERROR or CRITICAL.
RECRUITFLOW_LOG_LEVEL=INFO

# --- ML -----------------------------------------------------------------
# Where the trained matcher is persisted. Relative paths resolve from the
# repository root.
RECRUITFLOW_MODEL_PATH=backend/app/ml/artifacts/matcher.joblib

# Deterministic seed used by the corpus generator and training split.
RECRUITFLOW_RANDOM_SEED=42
